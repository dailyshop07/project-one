# HTTPS endpoint that returns Cloudflare-style short-lived WebRTC credentials:
# { "iceServers": [{ "urls": ["stun:...", "turn:..."], "username": "...", "credential": "..." }] }
# Keep the TURN API token in that backend; never put it in a VITE_* variable.
VITE_TURN_CREDENTIALS_URL=https://your-worker.example.com/turn-credentials
