{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "project-one-sync",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-07",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNC_ROOM",
        "class_name": "ProjectOneSyncRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ProjectOneSyncRoom"]
    }
  ]
}
